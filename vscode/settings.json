{
    "terminal.integrated.defaultProfile.osx": "bash",
    "terminal.integrated.enableVisualBell": true,
    "files.insertFinalNewline": true,
    "editor.renderFinalNewline": "dimmed",
    "workbench.startupEditor": "none",
    "github.copilot.enable": {
        "*": true,
        "plaintext": false,
        "markdown": true,
        "scminput": false
    },
    "workbench.editor.enablePreview": false,
    "[shellscript]": {
        "editor.insertSpaces": false
    },
    "github.copilot.nextEditSuggestions.enabled": true,
    "chat.tools.terminal.blockDetectedFileWrites": "outsideWorkspace",
    "chat.agent.maxRequests": 1000,
    "accessibility.signals.chatUserActionRequired": {
        "sound": "on"
    },
    "accessibility.signals.chatResponseReceived": {
        "sound": "on"
    },
    "editor.accessibilitySupport": "off",
    "github.copilot.chat.localeOverride": "ja",
    "chat.tools.terminal.autoApprove": {
        "cd": true,
        "cp": true,
        "echo": true,
        "ls": true,
        "pwd": true,
        "cat": true,
        "head": true,
        "tail": true,
        "wc": true,
        "tr": true,
        "cut": true,
        "cmp": true,
        "which": true,
        "basename": true,
        "dirname": true,
        "realpath": true,
        "readlink": true,
        "stat": true,
        "file": true,
        "hexdump": true,
        "diff": true,
        "du": true,
        "df": true,
        "sleep": true,
        "grep": true,
        "git status": true,
        "git log": true,
        "git show": true,
        "git diff": true,
        "git grep": true,
        "git branch": true,
        "git fetch": true,
        "git stash show": true,
        "git check-ignore": true,
        "git rev-parse": true,
        "/^git branch\\b.*-(d|D|m|M|-delete|-force)\\b/": false,
        "go": true,
        "gofmt": true,
        "date": true,
        "/^date\\b.*(-s|--set)\\b/": false,
        "find": true,
        "/^find\\b.*-(delete|exec|execdir|fprint|fprintf|fls|ok|okdir)\\b/": false,
        "sort": true,
        "/^sort\\b.*-(o|S)\\b/": false,
        "tree": true,
        "/^tree\\b.*-o\\b/": false,
        "column": true,
        "/^column\\b.*-c\\s+[0-9]{4,}/": false,
        "rm": false,
        "rmdir": false,
        "dd": false,
        "kill": false,
        "ps": false,
        "top": false,
        "curl": false,
        "wget": false,
        "chmod": false,
        "chown": false,
        "jq": false,
        "xargs": false,
        "eval": false,
        "gh pr view": true,
        "gh pr diff": true,
        "gh run view": true,
        "gh run list": true,
        "gh run watch": true,
        "gh repo view": true,
        "gh variable list": true,
        "gh secret list": true,
        "sed": true,
        "touch": true,
        "mkdir": true,
        "mktemp": true,
        "aws": true,
        "terraform plan": true,
        "/terragrunt(\\s+run)?(\\s+--all)?\\s+plan/": true,
        "python": true,
        "python3": true,
        ".venv/bin/python": true,
        "uv": true,
        "make": true,
        "poetry": true,
        "timeout": true,
        "source": true,
        "iconv": true,
        "time": true,
        "tee": true,
        "global": true,
        "gtags": true,
        "pygmentize": true,
        "ctags": true,
        "copilot": true,
        "gemini": true,
        ">\\s*/tmp/": true,
        ">\\s*/dev/null": true,
        "./tfdep": true,
        "gdb": true,
        "od": true,
        "code": true,
        "build/": true,
        "tmp/": true,
        "gcc": true,
        "bc": true,
        "uniq": true,
        "docker": true,
        "true": true,
        "md5sum": true,
        "npm install": true,
        "node": true,
        "npx": true,
        "npm run": true,
        "command": true
    },
    "remote.autoForwardPortsSource": "hybrid",
    "aws.telemetry": false,
    "github.copilot.chat.anthropic.tools.websearch.userLocation": {},
    "aws.cloudformation.telemetry.enabled": false,
    "scm.repositories.selectionMode": "single",
    "chat.tools.urls.autoApprove": {
        "https://*.github.com": true,
        "https://*.google.com": true,
        "https://containers.dev": true,
        "https://*.github.io": true,
        "https://www.bing.com": true,
        "https://*.githubusercontent.com": true,
        "https://*.google.dev": true,
        "https://github.blog": true,
        "https://*.gnu.org": true,
        "https://stackoverflow.com": true,
        "https://duckduckgo.com": true,
        "https://googleapis.dev": true,
        "https://*.hashicorp.com": true,
        "https://code.visualstudio.com": true,
        "https://www.npmjs.com": true,
        "https://pptr.dev": true,
        "https://*.wikipedia.org": true,
        "https://github.com": true,
        "https://*.substack.com": true,
        "https://martinfowler.com": true,
        "https://*.anthropic.com": true,
        "https://*.deepmind.com": true,
        "https://deepmind.google": true,
        "https://*.microsoft.com": true,
        "https://*.openai.com": true,
        "https://*.promptingguide.ai": true,
        "https://*.claude.com": true,
        "https://arxiv.org": true,
        "https://mermaid.js.org": true,
        "https://*.llvm.org": true,
        "https://*.doxygen.nl": true,
        "https://*.infracost.io": true,
        "https://*.gruntwork.io": true,
        "https://*.spacelift.io": true,
        "https://*.env0.com": true,
        "https://*.cloudflare.com": true,
        "https://pixijs.com": true
    },
    "chat.viewSessions.orientation": "stacked",
    "chat.customAgentInSubagent.enabled": true,
    "http.systemCertificatesNode": true,
    "chat.requestQueuing.defaultAction": "queue",
    "geminicodeassist.agentYoloMode": true
}
